{
  "name": "mcp_resume",
  "version": "0.0.1",
  "description": "Resume via MCP server",
  "main": "index.js",
  "scripts": {
    "copy:web-static": "node scripts/copy-web-static.mjs",
    "build": "pnpm build:common && pnpm build:data && pnpm build:domain",
    "build:common": "pnpm --filter @portfolio/common build",
    "build:data": "pnpm --filter @portfolio/data build",
    "build:domain": "pnpm --filter @portfolio/domain build",
    "build:api": "pnpm build && pnpm --filter api build",
    "build:web": "pnpm build && pnpm --filter web build",
    "build:all": "pnpm build && pnpm --filter web build && pnpm copy:web-static && pnpm --filter api build",
    "api": "pnpm --filter api",
    "web": "pnpm --filter web",
    "api:dev": "pnpm build && pnpm --filter api start:dev",
    "web:dev": "pnpm --filter web dev",
    "lint:ts": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"**/package.json\" \"*.cjs\" \"prettier.config.js\"",
    "lint:ts:fix": "pnpm lint:ts --fix",
    "prettier:fix": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"**/*.md\" \"skills/**/*.md\" \"docs/**/*.md\" \"*.cjs\" \"prettier.config.js\" \"**/package.json\"",
    "test": "pnpm test:common && pnpm test:data && pnpm test:domain && pnpm test:api",
    "test:api": "pnpm --filter api test",
    "test:common": "pnpm --filter @portfolio/common test",
    "test:data": "pnpm --filter @portfolio/data test",
    "test:domain": "pnpm build:common && pnpm build:data && pnpm --filter @portfolio/domain test",
    "test:cov": "pnpm test:common:cov && pnpm test:data:cov && pnpm test:domain:cov && pnpm test:api:cov",
    "test:api:cov": "pnpm --filter api test:cov",
    "test:common:cov": "pnpm --filter @portfolio/common test:cov",
    "test:data:cov": "pnpm --filter @portfolio/data test:cov",
    "test:domain:cov": "pnpm build:common && pnpm build:data && pnpm --filter @portfolio/domain test:cov"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/jest": "~30.0.0",
    "@types/node": "~26.2.0",
    "eslint": "~10.6.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-import-x": "~4.17.1",
    "eslint-plugin-package-json": "~1.5.0",
    "eslint-plugin-prettier": "~5.5.6",
    "globals": "~17.7.0",
    "jest": "~30.4.2",
    "prettier": "~3.9.4",
    "ts-jest": "~29.4.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.62.1"
  },
  "keywords": [],
  "author": "Kirill Budaev",
  "license": "ISC",
  "packageManager": "pnpm@11.22.0",
  "type": "module"
}
